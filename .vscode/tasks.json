
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: Commit and Push",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Enter your commit message",
      "default": "Update"
    }
  ]
}
